# Bioacustica Fauna -- entorno local/Docker

# Database
DB_NAME=bioacustica_fauna
DB_USER=bioacustica_user
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://bioacustica_user:changeme@localhost:5432/bioacustica_fauna

# API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
LOG_LEVEL=INFO
MAX_FILE_MB=50

# Modelo principal: tesis multitaxon
MODEL_TYPE=efficientnet
MODEL_BACKBONE=
MODEL_CHECKPOINT_PATH=/app/models/trained/multitaxon/best_efficientnet.pt
MODEL_PATH=models/trained/multitaxon/best_efficientnet.pt
MODEL_DEVICE=cpu
MODEL_TOP_K=5
MIN_PROB=0.05

# Fuentes de datos
# Xeno-canto API v3 requiere key para descargas desde octubre de 2025.
XENO_CANTO_API_KEY=

# Puertos externos Docker
API_EXTERNAL_PORT=8000
DB_EXTERNAL_PORT=5432
PGADMIN_EXTERNAL_PORT=5050
MLFLOW_EXTERNAL_PORT=5000

# pgAdmin
PGADMIN_EMAIL=admin@bioacustica-fauna.local
PGADMIN_PASSWORD=pgadmin_changeme
