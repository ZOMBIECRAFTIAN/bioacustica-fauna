# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno para docker-compose
# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env y ajustar valores antes del primer arranque:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=bioacoustics
DB_USER=bioacoustics_user
DB_PASSWORD=changeme_strong_password
# Puerto expuesto al host (cambiar si 5432 ya está ocupado)
DB_EXTERNAL_PORT=5432

# ── FastAPI ───────────────────────────────────────────────────────────────────
APP_ENV=production
APP_WORKERS=1
LOG_LEVEL=INFO
API_EXTERNAL_PORT=8000

# ── Modelo ML ────────────────────────────────────────────────────────────────
# Tipos disponibles: cnn_baseline | efficientnet | panns
MODEL_TYPE=efficientnet
MODEL_BACKBONE=efficientnet_b0
# cpu | cuda (requiere imagen con CUDA, ver comentario en Dockerfile)
MODEL_DEVICE=cpu
MODEL_TOP_K=5

# ── pgAdmin 4 ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@bioacoustics.local
PGADMIN_PASSWORD=pgadmin_changeme
PGADMIN_EXTERNAL_PORT=5050

# ── MLflow (solo activo con: docker-compose --profile mlflow up) ──────────────
MLFLOW_EXTERNAL_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
